# ============================================================================
# ENVIRONMENT VARIABLES FOR SOL CALARBONE 8
# ============================================================================

# === CORE ===
# Claude API key (REQUIRED for Solar8 to boot)
ANTHROPIC_API_KEY=sk-...

# Port to run the server on (default: 8080 in Railway, 8000 locally)
PORT=8000

# Environment type: "production" or "development" (controls reload behavior)
ENV=production

# === DATABASES ===
# PostgreSQL connection string (REQUIRED for Sol's identity + memory)
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://user:password@localhost:5432/wootangular369

# Turso/SQLite connection (optional, defaults to local sqlite:///rep_partay.db)
# TURSO_DATABASE_URL=libsql+wss://...
# TURSO_DATABASE_AUTH_TOKEN=...

# === AUTHENTICATION ===
# Admin credentials for /api/chat endpoint
# Defaults: "Ohad" / "route666" (CHANGE IN PRODUCTION)
ADMIN_USERNAME=Ohad
ADMIN_PASSWORD=route666

# Alternative credential format for /api/auth endpoint
ROOT_CREDENTIAL=Ohad:route666

# === DISCOVERY ===
# Base URL for this instance (used in agent discovery)
# Defaults to http://localhost:8000 locally
BASE_URL=https://web-production-xxxx.up.railway.app

# === A2A NETWORKING (Optional, for Step 2) ===
# URL where this Solar8 instance can be reached
SOLAR8_URL=https://web-production-xxxx.up.railway.app

# ============================================================================
# NOTES
# ============================================================================
# TURSO_DATABASE_URL: Ephemeral memory for Rep Partay conversations only
# DATABASE_URL: Permanent PostgreSQL (Sol's hard drive + sense of self)
#
# On Railway:
# - DATABASE_URL is provided by PostgreSQL add-on
# - TURSO_DATABASE_URL is optional (uses sqlite:///rep_partay.db if not set)
# - ANTHROPIC_API_KEY must be added manually
#
# For Step 1 (Solo mode): Only need DATABASE_URL + ANTHROPIC_API_KEY
# For Step 2 (A2A mode): Add SOLAR8_URL + A2A infrastructure
